# Local environment variables for Ticketly
# Copy this file to .env and fill in your keys before running locally

# Resend API key (create at https://resend.com/account/api-keys)
RESEND_API_KEY=re_your_api_key_here

# The 'from' address to use when sending emails. MUST be a verified domain in Resend for production sends.
# Example: RESEND_FROM="Ticketly <onboarding@yourdomain.com>"
RESEND_FROM="Ticketly <onboarding@yourdomain.com>"

# Optional: origin used in email links (defaults to http://localhost:5173)
# ORIGIN="http://localhost:5173"

# If you want to use a fake/test SMTP (Ethereal) locally instead of Resend,
# set this to true. The app will then send emails to Ethereal and print a
# preview URL instead of delivering real emails.
USE_FAKE_EMAIL=true
